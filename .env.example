# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# These are NAMES ONLY. Never commit a real key, and never bake one into a Docker image.

# --- primary language model (required) ---------------------------------------
GRIDWISE_LLM_PROVIDER=gemini
GRIDWISE_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# --- optional second language-model provider used only if the primary fails ---
# GRIDWISE_LLM_FALLBACK_PROVIDER=anthropic
# GRIDWISE_LLM_FALLBACK_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- optional third provider --------------------------------------------------
# OPENAI_API_KEY=

# --- tuning -------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=12
LLM_TRANSPORT_RETRIES=1
LLM_REPAIR_ATTEMPTS=1
PORT=8000
LOG_LEVEL=INFO
